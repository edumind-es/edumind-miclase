dist/
# Sin barra tambien: desde que desplegar.sh publica por enlace simbolico,
# frontend/dist es un enlace, y «dist/» solo casa con directorios. Se colo
# commiteado con la ruta absoluta de este servidor.
frontend/dist
*.db
*.db-wal
*.db-shm
.env
backend/data/
.DS_Store
*.log
*.tsbuildinfo

# Artefactos de compilación nativa (Capacitor).
# El proyecto Xcode y el de Gradle SÍ se versionan: llevan la configuración
# de permisos e iconos. Lo que se ignora es lo que se regenera al compilar.
frontend/ios/App/Pods/
frontend/ios/App/App/public/
frontend/ios/App/build/
frontend/android/app/src/main/assets/public/
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/

# Versiones publicadas: se generan al desplegar (ver desplegar.sh)
frontend/releases/
