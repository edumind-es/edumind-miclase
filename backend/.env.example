# Configuración del backend de EDUmind MiClase.
# Copia este fichero a .env para desarrollo. En producción las variables las
# inyecta el unit de systemd, y los secretos viven en
# /etc/edumind-miclase-api.env con permisos 600 (ver DESPLIEGUE.md).

NODE_ENV=development
PORT=3270

# Obligatorio. Mínimo 32 caracteres y distinto del valor de ejemplo: el
# backend no arranca si falta, es corto o es un valor publicado.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=genera_el_tuyo_con_openssl_rand_hex_32

# Rutas. DB_PATH por defecto es backend/data/miclase.db
DB_PATH=./data/miclase.db
CURRICULUM_PATH=../curriculum

# Authentik (OIDC). Sin AUTHENTIK_CLIENT_ID el login SSO queda desactivado y
# la app funciona solo en modo local; /api/auth/callback devuelve 503.
AUTHENTIK_URL=https://auth.edumind.es
AUTHENTIK_SLUG=miclase
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://miclase.edumind.es/auth/callback
